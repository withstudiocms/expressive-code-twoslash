{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>withstudiocms/renovate-config"],
	"packageRules": [
		{
			"groupName": "Expressive Code Twoslash Dependencies",
			"matchManagers": ["npm"],
			"matchFileNames": ["packages/expressive-code-twoslash/**"]
		},
		{
			"groupName": "Twoslash Core Dependencies",
			"matchManagers": ["npm"],
			"matchFileNames": ["packages/@ec-ts/twoslash/**"]
		},
		{
			"groupName": "Twoslash Vue Dependencies",
			"matchManagers": ["npm"],
			"matchFileNames": ["packages/@ec-ts/twoslash-vue/**"]
		},
		{
			"groupName": "VFS Dependencies",
			"matchManagers": ["npm"],
			"matchFileNames": ["packages/@ec-ts/vfs/**"]
		},
		{
			"groupName": "CSS JS Gen Dependencies",
			"matchManagers": ["npm"],
			"matchFileNames": ["packages/css-js-gen/**"]
		},
		{
			"groupName": "Docs Dependencies",
			"matchManagers": ["npm"],
			"matchFileNames": ["docs/**"]
		},
		{
			"groupName": "Playground Dependencies",
			"matchManagers": ["npm"],
			"matchFileNames": ["playground/**"]
		}
	],
	"ignoreDeps": ["eslint"]
}
