---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";

interface Props {
	lang: string;
	code: string;
	meta?: string;
	mode?: "twoslash" | "eslint";
}

const { lang, code: rawCode, meta, mode = "twoslash" } = Astro.props;

// Remove any lines which are for the compiler and not relevant to the user, as well as any lines which are for the editor and not relevant to the user.
// These are not relevant to the user and just add noise to the code sample. (Used internally to keep docs linter and ts compiler happy, but not relevant to the user).
const code = rawCode
	.split("\n")
	.filter((line) => !line.includes("// @ts-nocheck"))
	.filter((line) => !line.includes("/** biome-ignore-all"))
	.join("\n");

// Create a markdown snippet which can be used in the markdown tab, which includes the language and mode as metadata for the code block, as well as any additional metadata passed in via the `meta` prop.
const mdSnippet = `\`\`\`${lang} ${mode}${meta ? ` ${meta}` : ""}\n${code}\n\`\`\``;

const createHash = (str: string) => {
	let hash = 0;
	for (let i = 0; i < str.length; i++) {
		hash = (hash << 5) - hash + str.charCodeAt(i);
		hash |= 0; // Convert to 32bit integer
	}
	return Math.abs(hash).toString(36);
};

const langCodeHash = `${lang}-${createHash(code)}`;
---
<Tabs syncKey={langCodeHash}>
    <TabItem label="Rendered Output">
        <Code {lang} {code} meta={`${mode}${meta ? ` ${meta}` : ''}`} />
    </TabItem>
    <TabItem label="Markdown">
        <Code lang={'md'} code={mdSnippet} meta={meta} />
    </TabItem>
</Tabs>